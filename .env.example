# === YT MENTOR — Variables d'environnement ===
# Copier ce fichier vers .env et remplir. Ne JAMAIS committer .env.

# --- Base de données Neon (Postgres serverless) ---
# Format : postgresql://USER:PASSWORD@EP_HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/db?sslmode=require"

# --- Google Cloud (YouTube OAuth) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URL de callback autorisée : https://<ton-domaine>/api/youtube/callback
# (en local : http://localhost:3000/api/youtube/callback)

# --- NextAuth ---
NEXTAUTH_SECRET="generate-un-secret-avec-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Chiffrement des refresh tokens YouTube (AES-256-GCM) ---
# Générer : openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Resend (emails d'alerte) ---
RESEND_API_KEY=""
ALERT_FROM_EMAIL="alerts@ton-domaine.com"

# --- GLM-5.2 via Cloudflare Workers AI (modèle mentor principal) ---
# 6 comptes CF pour round-robin (mêmes que orchestra.py)
CF_ACCOUNT_1_ID=""
CF_ACCOUNT_1_TOKEN=""
CF_ACCOUNT_2_ID=""
CF_ACCOUNT_2_TOKEN=""
CF_ACCOUNT_3_ID=""
CF_ACCOUNT_3_TOKEN=""
CF_ACCOUNT_4_ID=""
CF_ACCOUNT_4_TOKEN=""
CF_ACCOUNT_5_ID=""
CF_ACCOUNT_5_TOKEN=""
CF_ACCOUNT_6_ID=""
CF_ACCOUNT_6_TOKEN=""

# --- Fallback MiniMax M2.7 via Dahl (optionnel) ---
DAHL_API_KEY=""

# --- Vercel Cron (secret partagé pour /api/cron/sync) ---
CRON_SECRET=""

# --- YouTube OAuth scopes ---
YOUTUBE_SCOPES="https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly"
